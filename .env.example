#--------------------------------------------------------------------
# .env.example — Feature 1: Consulta Pública con Captcha
#
# Copia este archivo como ".env" y ajusta los valores. NUNCA subas el
# ".env" real al repositorio: contiene credenciales y está en .gitignore.
#
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows / CMD)
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# RÉPLICA MYSQL (HU-22)
#--------------------------------------------------------------------
# El ApiRest solo se conecta a la réplica, con un usuario de solo lectura.
# Dentro de Docker el host es "mysql-replica" y el puerto 3306 (ya fijados en
# docker-compose.yml). Este es el puerto con el que se llega desde TU máquina
# (por ejemplo, para abrir la réplica en un cliente SQL):
REPLICA_DB_HOST_PORT=3307
REPLICA_DB_NAME=oficina_agua
# Usuario del ApiRest: únicamente permiso SELECT.
REPLICA_DB_USER=consulta_ro
REPLICA_DB_PASSWORD=cambiar_esta_password
# Usuario administrador del contenedor de la réplica (solo para inicializarla).
REPLICA_DB_ROOT_PASSWORD=cambiar_esta_password_root

#--------------------------------------------------------------------
# APIREST DE CONSULTA (HU-23)
#--------------------------------------------------------------------
API_PORT=8081
# URL interna del ApiRest. Solo la conoce el servidor Web, nunca el navegador.
# Dentro de Docker Compose se arma sola a partir de API_PORT; este valor solo se usa
# si corres la capa Web fuera de Docker (npm run dev).
API_INTERNAL_URL=http://api:8081

#--------------------------------------------------------------------
# RATE LIMIT POR IP (HU-24)
#--------------------------------------------------------------------
# Máximo de consultas por IP dentro de la ventana de tiempo.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Leer la IP real del cliente desde X-Forwarded-For (la envia la capa Web).
# Solo debe ser true si el ApiRest NO es accesible directamente desde internet:
# si lo fuera, cualquiera podria falsear la cabecera y esquivar el limite.
RATE_LIMIT_TRUST_FORWARDED_FOR=true

#--------------------------------------------------------------------
# CAPTCHA (HU-25, HU-26) — reCAPTCHA v2 o hCaptcha
#--------------------------------------------------------------------
# Proveedor elegido: recaptcha | hcaptcha
CAPTCHA_PROVIDER=recaptcha
# Clave pública: viaja al navegador, no es secreta.
# Clave secreta: solo en el servidor, nunca al navegador.
#
# Los valores de abajo son las claves de PRUEBA que publica Google para reCAPTCHA v2:
# el captcha siempre se aprueba y muestra un aviso de "solo para pruebas". Sirven para
# desarrollar en local. Para producción hay que registrar el sitio en
# https://www.google.com/recaptcha/admin y poner las claves reales.
#
# Si el proveedor es hCaptcha, las claves de prueba de hCaptcha son:
#   CAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
#   CAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
CAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
CAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

#--------------------------------------------------------------------
# WEB (HU-25)
#--------------------------------------------------------------------
WEB_PORT=3000
# false (lo normal): el navegador se conecta directo a Next.js y se usa la IP real de la
# conexion para el rate limit. true: solo si hay un proxy de confianza delante (nginx, un
# balanceador) que ya pone la IP correcta en X-Forwarded-For.
TRUST_PROXY_HEADERS=false

#--------------------------------------------------------------------
# CHAT (HU-59) — widget del chatbot de la Feature 2
#--------------------------------------------------------------------
# El widget se instala como dependencia (paquete oficina-agua-chat-widget, repositorio de la
# Feature 2) y se monta en esta misma pagina. El ApiRest del chatbot NO corre en este
# docker-compose: se levanta desde el repositorio de la Feature 2.
# URL del ApiRest del chatbot. Solo la conoce el servidor Web, nunca el navegador.
# Debe ser un puerto distinto de API_PORT (8081, ApiRest de consulta). Ejemplo: levantar el
# ApiRest del chatbot con SERVER_PORT=8083. "host.docker.internal" es la maquina anfitriona.
CHAT_API_URL=http://host.docker.internal:8083
# Espera maxima al ApiRest del chatbot (el LLM puede tardar).
CHAT_TIMEOUT_MS=70000
# Preguntas permitidas por IP en cada ventana. 0 desactiva el limite del chat.
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
